OPENAI_API_KEY=
GEMINI_API_KEY=
DATABASE_URL=

# Protects Vercel Cron endpoints under /api/cron/game-calendar/*.
CRON_SECRET=

# Optional text model for Game Content AI summaries.
# If GEMINI_API_KEY is missing, the system uses a safe deterministic fallback.
GAME_CONTENT_AI_MODEL=gemini-2.5-flash

# Optional provider credentials for future Game Calendar connectors.
# Leave blank until the related provider is implemented and approved.
YOUTUBE_API_KEY=
X_BEARER_TOKEN=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
DISCORD_WEBHOOK_URL=
LINE_CHANNEL_ACCESS_TOKEN=
TELEGRAM_BOT_TOKEN=

# Auth sessions are stored in the database and set as an HttpOnly cookie.
# Keep this value stable after users start signing in.
AUTH_SESSION_COOKIE_NAME=lazyai_session

# Comma-separated emails that can access admin tools before their DB role is admin.
ADMIN_EMAILS=

# Manual payment instructions shown on /checkout.
BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=

# Manual payment requests expire after this many hours (1-168, default 24).
PAYMENT_PENDING_HOURS=24

# Private Vercel Blob store used for payment proof and VIP support images.
# Vercel adds this automatically after the private store is connected.
BLOB_READ_WRITE_TOKEN=

# Optional defaults used when the browser does not send model settings.
IMAGE_MODEL=gpt-image-1.5
IMAGE_QUALITY=medium

# M2 external media worker: install ffprobe and set its executable path if not on PATH.
# Run npm run media:worker:build before npm run media:worker on the worker host.
FFPROBE_PATH=

# M3 worker: FFmpeg with libx264. Optional vision model uses GEMINI_API_KEY.
# Leave the model empty to use manual highlight planning; no external analysis call is made.
FFMPEG_PATH=
MOTION_VISION_MODEL=

# M4: install a Thai-capable font on both web and worker hosts.
# On Windows the frame renderer defaults to C:/Windows/Fonts/tahoma.ttf.
FRAME_FONT_PATH=
